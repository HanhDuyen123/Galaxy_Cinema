
@model IEnumerable<GalaxyCinema.Models.MovieShowtimesViewModel>


@if (Model == null || !Model.Any())
{
    <div class="no-showtimes">
        <p>Không có suất chiếu nào vào ngày này.</p>
    </div>
}
else
{
    foreach (var item in Model)
    {
        <div class="movie-item">
            <div class="movie-info">
                <div class="movie-poster">
                    <img src="@Url.Content("/Content/Img/" + @item.Movie.POSTER)" alt="@item.Movie.MOVIENAME">
                </div>
                <div class="movie-details">
                    <h5 class="fw-bold">@item.Movie.MOVIENAME</h5>
                    <div class="age-rating">@item.Movie.AGERATING.AGERATING1</div>
                    <p>Thể loại: @item.Genres</p>
                    <p>Thời lượng: @item.Movie.DURATION phút</p>
                </div>
            </div>

            <div class="showtimes">
                @foreach (var showtime in item.Showtimes)
                {
                    <a href="@Url.Action("Details", "Booking", new { showtimeId = showtime.SHOWTIMEID })" class="showtime text-decoration-none text-dark">
                        @showtime.STARTTIME.ToString("HH:mm")
                    </a>
                }
            </div>
        </div>
    }

}