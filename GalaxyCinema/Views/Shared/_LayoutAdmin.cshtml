    <style>
        /* Thêm style cho active nav */
        .nav-link.active {
            background-color: #6c757d70 !important;
            color: white !important;
            border-radius: 5px;
        }

        .nav-link.focus {
            background-color: #007bff !important;
            color: white !important;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <nav class="sidebar mt-3 d-flex flex-column justify-content-between" id="sidebar">
        <ul class="nav flex-column mb-auto">
            <li class="nav-item">
                <a href="~/Movies/Index" class="nav-link text-black" data-controller="movies">
                    <i class="bi bi-film me-2"></i> Phim
                </a>
            </li>
            <li class="nav-item">
                <a href="~/Actors/Index" class="nav-link text-black" data-controller="actors">
                    <i class="bi bi-person-video3 me-2"></i> Diễn viên
                </a>
            </li>
            <li class="nav-item">
                <a href="~/Directors/Index" class="nav-link text-black" data-controller="directors">
                    <i class="bi bi-person-badge me-2"></i> Đạo diễn
                </a>
            </li>
            <li class="nav-item">
                <a href="~/Schedule/Index" class="nav-link text-black" data-controller="schedule">
                    <i class="bi bi-calendar-event me-2"></i> Lịch chiếu
                </a>
            </li>
            <li class="nav-item">
                <a href="~/Booking/Index" class="nav-link text-black" data-controller="booking">
                    <i class="bi bi-ticket-perforated me-2"></i> Đặt vé
                </a>
            </li>
            <li class="nav-item">
                <a href="~/Revenue/Index" class="nav-link text-black" data-controller="revenue">
                    <i class="bi bi-bar-chart-line me-2"></i> Thống kê
                </a>
            </li>
        </ul>

        <!-- User Profile and Logout -->
        <div class="logout mt-auto">
            <a href="~/Login/Logout" class="nav-link text-danger fw-bold">
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
        </div>
    </nav>

    <!-- Overlay -->
    <div id="overlay"></div>

    <!-- Toggle Button -->
    <button id="toggleSidebar" class="btn">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Main Content -->
    <div class="main-content container-fluid" id="main-content">
        <!-- Header -->
        <div class="header d-flex justify-content-end">
            <div class="user-info mx-3">
                <span class="mx-3">@Session["fullname"]</span>
                <i class="fa-regular fa-user"></i>
            </div>
        </div>

        <!-- Content Area -->
        <div class="content">
            @RenderBody()
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Function to highlight active navigation
            function highlightActiveNav() {
                const navLinks = document.querySelectorAll(".nav-link[data-controller]");
                const currentPath = window.location.pathname.toLowerCase();

                // Debug: Log current path
                console.log("Current path:", currentPath);

                // Remove all existing active/focus classes
                navLinks.forEach(link => {
                    link.classList.remove("active", "focus");
                });

                // Find and highlight the matching nav item
                navLinks.forEach(link => {
                    const controller = link.getAttribute("data-controller");

                    // Debug: Log each controller check
                    console.log(`Checking controller: ${controller}, Path includes /${controller}:`, currentPath.includes("/" + controller));

                    if (controller && currentPath.includes("/" + controller)) {
                        link.classList.add("active");
                        console.log(`Activated nav for controller: ${controller}`);
                    }
                });

                // If no match found, try case-insensitive matching
                const hasActiveNav = document.querySelector(".nav-link.active");
                if (!hasActiveNav) {
                    console.log("No active nav found, trying case-insensitive matching...");

                    navLinks.forEach(link => {
                        const controller = link.getAttribute("data-controller").toLowerCase();

                        // More flexible matching patterns
                        if (currentPath.includes("/" + controller + "/") ||
                            currentPath.endsWith("/" + controller) ||
                            currentPath === "/" + controller) {
                            link.classList.add("active");
                            console.log(`Activated nav (case-insensitive) for controller: ${controller}`);
                        }
                    });
                }
            }

            // Run the highlight function
            highlightActiveNav();

            // Rest of your sidebar toggle code...
            const sidebar = document.getElementById("sidebar");
            const toggleSidebar = document.getElementById("toggleSidebar");
            const overlay = document.getElementById("overlay");
            const mainContent = document.getElementById("main-content");

            const toggleSidebarVisibility = () => {
                sidebar.classList.toggle("active");
                overlay.classList.toggle("active");
                mainContent.classList.toggle("sidebar-active");

                if (sidebar.classList.contains("active")) {
                    toggleSidebar.style.display = "none";
                } else {
                    toggleSidebar.style.display = "block";
                }
            };

            toggleSidebar.addEventListener("click", toggleSidebarVisibility);
            overlay.addEventListener("click", toggleSidebarVisibility);

            const updateToggleButtonVisibility = () => {
                if (window.innerWidth >= 768) {
                    toggleSidebar.style.display = "none";
                    sidebar.classList.remove("active");
                    overlay.classList.remove("active");
                    mainContent.classList.remove("sidebar-active");
                } else {
                    toggleSidebar.style.display = "block";
                }
            };

            updateToggleButtonVisibility();
            window.addEventListener("resize", updateToggleButtonVisibility);
        });
