@model IEnumerable<GalaxyCinema.Models.DAYCAT>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.DAYCATNAME)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DAYCATNAME)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.DAYCATID }) |
                @Html.ActionLink("Details", "Details", new { id = item.DAYCATID }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.DAYCATID })
            </td>
        </tr>
    }

</table>
