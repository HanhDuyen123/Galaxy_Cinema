@model GalaxyCinema.Models.MOVIE

@{
    ViewBag.Title = "Chi Tiết Phim";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var ageSelect = ViewBag.AgeRatings as SelectList;
    var fieldName = ageSelect?.DataTextField;
    object ageValue = null;
    if (fieldName != null && Model.AGERATING != null)
    {
        var prop = Model.AGERATING.GetType().GetProperty(fieldName);
        if (prop != null)
        {
            ageValue = prop.GetValue(Model.AGERATING, null);
        }
    }
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white text-center py-3">
            <h2 class="mb-0">@Model.MOVIENAME</h2>
        </div>

        <div class="card-body row">
            <div class="col-md-4 text-center">
                @if (!string.IsNullOrEmpty(Model.POSTER))
                {
                    <img src="@Url.Content("/Content/Img/" + Model.POSTER)" alt="Poster @Model.MOVIENAME"
                         class="img-fluid rounded border"
                         style="max-height: 400px; object-fit: cover;" />
                }
                else
                {
                    <div class="text-muted">Không có ảnh poster</div>
                }
            </div>

            <div class="col-md-8">
                <dl class="row fs-6">
                    <dt class="col-sm-4">🎬 Đạo diễn</dt>
                    <dd class="col-sm-8">@(!string.IsNullOrEmpty(Model.DIRECTOR?.DIRECTORNAME) ? Model.DIRECTOR.DIRECTORNAME : "Không có")</dd>

                    <dt class="col-sm-4">📚 Thể loại</dt>
                    <dd class="col-sm-8">
                        @(Model.GENREs.Any()
                            ? string.Join(", ", Model.GENREs.Select(g => g.GENRENAME))
                            : "Không có")
                    </dd>

                    <dt class="col-sm-4">🎭 Diễn viên</dt>
                    <dd class="col-sm-8">
                        @(Model.ACTORs.Any()
                            ? string.Join(", ", Model.ACTORs.Select(a => a.ACTORNAME))
                            : "Không có")
                    </dd>

                    <dt class="col-sm-4">🌎 Quốc gia</dt>
                    <dd class="col-sm-8">@Model.NATION?.NATIONNAME ?? "Không có"</dd>

                    <dt class="col-sm-4">📅 Ngày phát hành</dt>
                    <dd class="col-sm-8">@Model.RELEASEDATE.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4">🔞 Xếp hạng độ tuổi</dt>
                    <dd class="col-sm-8"><span class="badge bg-secondary">
    @(ageValue != null ? ageValue : "N/A")
</span></dd>

                    @if (!string.IsNullOrWhiteSpace(Model.MOVIESTATUS))
                    {
                        <dt class="col-sm-4">📌 Trạng thái</dt>
                        <dd class="col-sm-8">
                            @{
                                string statusText = "";
                                string badgeClass = "bg-secondary";

                                switch (Model.MOVIESTATUS)
                                {
                                    case "Coming Soon":
                                        statusText = "Sắp chiếu";
                                        badgeClass = "bg-warning text-dark";
                                        break;
                                    case "Released":
                                        statusText = "Đang chiếu";
                                        badgeClass = "bg-success";
                                        break;
                                    case "Archived":
                                        statusText = "Đã chiếu";
                                        badgeClass = "bg-dark";
                                        break;
                                }
                            }
                            <span class="badge @badgeClass px-3 py-2">@statusText</span>
                        </dd>
                    }

                    <dt class="col-sm-4">📝 Mô tả</dt>
                    <dd class="col-sm-8">@Model.DESCRIPTION</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "Movies")" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
            ← Quay lại danh sách
        </a>
    </div>
</div>
