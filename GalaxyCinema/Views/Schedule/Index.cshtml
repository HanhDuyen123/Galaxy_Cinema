@model IEnumerable<GalaxyCinema.Models.SHOWTIME>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<style>
    .movie-info {
        max-width: 200px;
    }

    .badge {
        font-size: 0.9em;
    }

    .btn-group .btn {
        margin: 0 2px;
    }

    .card-header h4 {
        color: #495057;
    }

    .alert {
        border: none;
        border-radius: 8px;
    }

    .table th {
        border-top: none;
        font-weight: 600;
    }

    .form-inline .form-group {
        align-items: center;
    }
</style>
<div class="container-fluid">
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="fas fa-calendar-alt"></i> Quản lý Lịch Chiếu
                    </h4>
                    <a href="@Url.Action("Create")" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Tạo Suất Chiếu Mới
                    </a>
                </div>

                <div class="card-body">
                    <!-- Bộ lọc -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <form method="get" class="form-inline">
                                <div class="form-group mr-3">
                                    <label for="theaterId" class="mr-2">Rạp chiếu:</label>
                                    @Html.DropDownList("theaterId", (IEnumerable<SelectListItem>)ViewBag.Theaters,
                                        "-- Tất cả rạp --", new { @class = "form-control", id = "theaterId" })
                                </div>

                                <div class="form-group mr-3">
                                    <label for="selectedDate" class="mr-2">Ngày chiếu:</label>
                                    <input type="date" name="selectedDate" id="selectedDate"
                                           value="@ViewBag.SelectedDate" class="form-control" />
                                </div>

                                <button type="submit" class="btn btn-info">
                                    <i class="fas fa-search"></i> Lọc
                                </button>

                                <a href="@Url.Action("Index")" class="btn btn-secondary ml-2">
                                    <i class="fas fa-undo"></i> Đặt lại
                                </a>
                            </form>
                        </div>
                    </div>

                    <!-- Thông báo -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle"></i> @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert">
                                <span>&times;</span>
                            </button>
                        </div>
                    }

                    <!-- Bảng danh sách suất chiếu -->
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Rạp</th>
                                    <th>Phim</th>
                                    <th>Ngày chiếu</th>
                                    <th>Giờ bắt đầu</th>
                                    <th>Giờ kết thúc</th>
                                    <th>Thời lượng</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@Html.DisplayFor(modelItem => item.THEATER.THEATERNAME)</strong>
                                            </td>
                                            <td>
                                                <div class="movie-info">
                                                    <strong>@Html.DisplayFor(modelItem => item.MOVIE.MOVIENAME)</strong>
                                                    <br />
                                                    <small class="text-muted">
                                                        @Html.DisplayFor(modelItem => item.MOVIE.DURATION) phút
                                                    </small>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge text-bg-info">
                                                    @item.STARTTIME.ToString("dd/MM/yyyy")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge text-bg-success">
                                                    @item.STARTTIME.ToString("HH:mm")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge text-bg-warning">
                                                    @item.ENDTIME.ToString("HH:mm")
                                                </span>
                                            </td>
                                            <td>
                                                @{
                                                    var duration = (item.ENDTIME - item.STARTTIME).TotalMinutes;
                                                }
                                                @Math.Round(duration) phút
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("Edit", new { id = item.SHOWTIMEID })"
                                                       class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            onclick="deleteShowtime(@item.SHOWTIMEID)" title="Xóa">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">
                                            <i class="fas fa-calendar-times fa-3x mb-3"></i>
                                            <br />
                                            Không có suất chiếu nào trong khoảng thời gian đã chọn.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle text-warning"></i>
                    Xác nhận xóa
                </h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa suất chiếu này không?
                <br /><small class="text-muted">Thao tác này không thể hoàn tác.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Xóa</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Khi page load, read token và cấu hình header


        let showtimeIdToDelete = 0;

        function deleteShowtime(id) {
            showtimeIdToDelete = id;
            $('#deleteModal').modal('show');
        }

        $('#confirmDelete').click(function () {
            var antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();
            if (showtimeIdToDelete > 0) {
                $.ajax({
                    url: '@Url.Action("Delete")',
                    type: 'POST',
                    data: { __RequestVerificationToken: antiForgeryToken, id: showtimeIdToDelete },
                    success: function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            toastr.error(response.message);
                        }
                        $('#deleteModal').modal('hide');
                    },
                    error: function() {
                        toastr.error('Có lỗi xảy ra khi xóa suất chiếu.');
                        $('#deleteModal').modal('hide');
                    }
                });
            }
        });

        // Auto submit form khi thay đổi filter
        $('#theaterId, #selectedDate').change(function() {
            $(this).closest('form').submit();
        });
    </script>
}