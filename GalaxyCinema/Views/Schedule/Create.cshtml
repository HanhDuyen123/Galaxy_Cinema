@model GalaxyCinema.Models.SHOWTIME
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-calendar-plus"></i> Tạo Suất Chiếu Mới
                    </h4>
                </div>

                <div class="card-body">
                    @using (Html.BeginForm("Create", "Schedule", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-row">
                            <!-- Chọn rạp -->
                            <div class="form-group col-md-6">
                                <label for="THEATERID" class="form-label required">
                                    <i class="fas fa-building"></i> Rạp chiếu
                                </label>
                                @Html.DropDownList("THEATERID", (IEnumerable<SelectListItem>)ViewBag.THEATERID,
                                    "-- Chọn rạp --", new { @class = "form-control", required = "required" })
                                @Html.ValidationMessageFor(model => model.THEATERID, "", new { @class = "invalid-feedback" })
                            </div>

                            <!-- Chọn phim -->
                            <div class="form-group col-md-6">
                                <label for="MOVIEID" class="form-label required">
                                    <i class="fas fa-film"></i> Phim
                                </label>
                                @Html.DropDownList("MOVIEID", (IEnumerable<SelectListItem>)ViewBag.MOVIEID,
                                    "-- Chọn phim --", new { @class = "form-control", required = "required" })
                                @Html.ValidationMessageFor(model => model.MOVIEID, "", new { @class = "invalid-feedback" })
                            </div>
                        </div>

                        <div class="form-row">
                            <!-- Ngày chiếu -->
                            <div class="form-group col-md-6">
                                <label for="STARTTIME_DATE" class="form-label required">
                                    <i class="fas fa-calendar"></i> Ngày chiếu
                                </label>
                                <input type="date" id="STARTTIME_DATE" class="form-control"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                <div class="invalid-feedback">
                                    Vui lòng chọn ngày chiếu.
                                </div>
                            </div>

                            <!-- Giờ chiếu -->
                            <div class="form-group col-md-6">
                                <label for="STARTTIME_TIME" class="form-label required">
                                    <i class="fas fa-clock"></i> Giờ bắt đầu
                                </label>
                                <input type="time" id="STARTTIME_TIME" class="form-control" required />
                                <div class="invalid-feedback">
                                    Vui lòng chọn giờ bắt đầu.
                                </div>
                            </div>
                        </div>

                        <!-- Trường ẩn cho STARTTIME -->
                        @Html.HiddenFor(model => model.STARTTIME)

                        <!-- Thông tin phim đã chọn -->
                        <div id="movieInfo" class="alert alert-info" style="display: none;">
                            <h6><i class="fas fa-info-circle"></i> Thông tin phim:</h6>
                            <div id="movieDetails"></div>
                        </div>

                        <!-- Kiểm tra xung đột lịch -->
                        <div id="conflictWarning" class="alert alert-warning" style="display: none;">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Cảnh báo:</strong> <span id="conflictMessage"></span>
                        </div>

                        <!-- Hiển thị validation errors -->
                        if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <h6><i class="fas fa-exclamation-circle"></i> Có lỗi xảy ra:</h6>
                                @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                            </div>
                        }

                        <div class="form-group text-center mt-4">
                            <button type="submit" class="btn btn-primary btn-lg mr-3" id="submitBtn">
                                <i class="fas fa-save"></i> Tạo Suất Chiếu
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                                <i class="fas fa-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Kết hợp ngày và giờ thành STARTTIME
            function updateStartTime() {
                const date = $('#STARTTIME_DATE').val();
                const time = $('#STARTTIME_TIME').val();

                if (date && time) {
                    const datetime = date + 'T' + time;
                    $('#STARTTIME').val(datetime);
                    checkScheduleConflict();
                }
            }

            // Lấy thông tin phim khi chọn
            $('#MOVIEID').change(function() {
                const movieId = $(this).val();
                if (movieId) {
                    $.ajax({
                        url: '@Url.Action("GetMovieInfo", "Movie")', // Cần tạo action này
                        type: 'GET',
                        data: { id: movieId },
                        success: function(movie) {
                            if (movie) {
                                $('#movieDetails').html(`
                                    <div class="row">
                                        <div class="col-md-6">
                                            <strong>Tên phim:</strong> ${movie.MovieName}<br/>
                                            <strong>Thời lượng:</strong> ${movie.Duration} phút
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Thể loại:</strong> ${movie.Genres || 'N/A'}<br/>
                                            <strong>Đạo diễn:</strong> ${movie.Director || 'N/A'}
                                        </div>
                                    </div>
                                `);
                                $('#movieInfo').show();
                            }
                        }
                    });
                } else {
                    $('#movieInfo').hide();
                }
            });

            // Kiểm tra xung đột lịch chiếu
            function checkScheduleConflict() {
                const theaterId = $('#THEATERID').val();
                const startTime = $('#STARTTIME').val();

                if (theaterId && startTime) {
                    $.ajax({
                        url: '@Url.Action("CheckScheduleConflict")',
                        type: 'GET',
                        data: {
                            theaterId: theaterId,
                            startTime: startTime,
                            movieId: $('#MOVIEID').val()
                        },
                        success: function(result) {
                            if (result.hasConflict) {
                                $('#conflictMessage').text(result.message);
                                $('#conflictWarning').show();
                                $('#submitBtn').prop('disabled', true);
                            } else {
                                $('#conflictWarning').hide();
                                $('#submitBtn').prop('disabled', false);
                            }
                        }
                    });
                }
            }

            // Event handlers
            $('#STARTTIME_DATE, #STARTTIME_TIME').change(updateStartTime);
            $('#THEATERID').change(checkScheduleConflict);

            // Validation
            $('form').on('submit', function(e) {
                const date = $('#STARTTIME_DATE').val();
                const time = $('#STARTTIME_TIME').val();

                if (!date || !time) {
                    e.preventDefault();
                    toastr.error('Vui lòng chọn đầy đủ ngày và giờ chiếu.');
                    return false;
                }

                updateStartTime();
            });

            // Bootstrap validation
            window.addEventListener('load', function() {
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function(form) {
                    form.addEventListener('submit', function(event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        });
    </script>
}
