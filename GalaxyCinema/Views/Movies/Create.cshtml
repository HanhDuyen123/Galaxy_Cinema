@model GalaxyCinema.Models.MOVIE

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-4">
    <h2 class="my-4">@ViewBag.Title</h2>

    <div class="form-container">
        <h2 class="text-center">Thêm Phim Mới</h2>

        @if (ViewData.ModelState.Any(ms => ms.Value.Errors.Any()))
        {
            <div class="alert alert-danger p-2 mb-3">
                <ul class="mb-0 small">
                    @foreach (var state in ViewData.ModelState.Values)
                    {
                        foreach (var err in state.Errors)
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    }
                </ul>
            </div>
        }

        @using (Html.BeginForm("Create", "Movies", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.MOVIENAME, "Tên phim", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.MOVIENAME, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.MOVIENAME, "", new { @class = "field-validation-error" })

                    <div class="mt-3">
                        <label class="form-label">Thể loại</label>
                        <div class="multi-select-container">
                            @Html.ListBox("selectedGenres", (MultiSelectList)ViewBag.Genres, new { @class = "form-control select2", @style = "height: auto;" })
                        </div>
                    </div>

                    @Html.LabelFor(m => m.NATIONID, "Quốc gia", new { @class = "form-label mt-3" })
                    @Html.DropDownListFor(m => m.NATIONID, (SelectList)ViewBag.NATIONID, "Chọn Quốc Gia", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.NATIONID, "", new { @class = "field-validation-error" })

                    @Html.LabelFor(m => m.MOVIESTATUS, "Trạng thái", new { @class = "form-label mt-3" })
                    @Html.DropDownListFor(m => m.MOVIESTATUS, new SelectList(new[] {
                        new { Value = "Coming Soon", Text = "Sắp chiếu" },
                        new { Value = "Released", Text = "Đang chiếu" },
                        //new { Value = "Ngừng chiếu", Text = "Ngừng chiếu" }
                    }, "Value", "Text"), "Chọn trạng thái", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.MOVIESTATUS, "", new { @class = "field-validation-error" })

                    @Html.LabelFor(m => m.RELEASEDATE, "Ngày phát hành", new { @class = "form-label mt-3" })
                    @Html.TextBoxFor(m => m.RELEASEDATE, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.RELEASEDATE, "", new { @class = "field-validation-error" })

                    @Html.LabelFor(m => m.DURATION, "Thời lượng (phút)", new { @class = "form-label mt-3" })
                    @Html.TextBoxFor(m => m.DURATION, new { @class = "form-control", type = "number", min = "1" })
                    @Html.ValidationMessageFor(m => m.DURATION, "", new { @class = "field-validation-error" })
                </div>

                <div class="col-md-6">
                    <div class="d-flex justify-content-between align-items-center">
                        @Html.LabelFor(m => m.DIRECTORID, "Đạo diễn", new { @class = "form-label mb-0" })
                        <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addDirectorModal">+</button>
                    </div>
                    @Html.DropDownListFor(m => m.DIRECTORID, (SelectList)ViewBag.DIRECTORID, "Chọn đạo diễn", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.DIRECTORID, "", new { @class = "field-validation-error" })

                    <div class="mt-3 d-flex justify-content-between align-items-center">
                        <label class="form-label mb-0">Diễn viên</label>
                        <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addActorModal">+</button>
                    </div>
                    <div class="multi-select-container">
                        @Html.ListBox("selectedActors", (MultiSelectList)ViewBag.Actors, new { @class = "form-control select2", @style = "height: auto;" })
                    </div>

                    @Html.LabelFor(m => m.AGEID, "Xếp hạng độ tuổi", new { @class = "form-label mt-3" })
                    @Html.DropDownListFor(m => m.AGEID, (SelectList)ViewBag.AGEID, "Chọn xếp hạng", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.AGEID, "", new { @class = "field-validation-error" })

                    <div class="mt-3">
                        @Html.Label("Ảnh Phim", new { @class = "form-label" })
                        <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                        <small class="text-muted">Chỉ chấp nhận file: .jpg, .jpeg, .png, .gif</small>
                    </div>

                    @Html.LabelFor(m => m.DESCRIPTION, "Mô tả", new { @class = "form-label mt-3" })
                    @Html.TextAreaFor(m => m.DESCRIPTION, new { @class = "form-control", rows = 4 })
                    @Html.ValidationMessageFor(m => m.DESCRIPTION, "", new { @class = "field-validation-error" })
                </div>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-primary me-2">Thêm Phim</button>
                <a href="@Url.Action("Index", "Movies")" class="btn btn-secondary">Quay lại</a>
            </div>
        }
    </div>
</div>

<!-- Modal Add Director -->
<div class="modal fade" id="addDirectorModal" tabindex="-1" aria-labelledby="addDirectorModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="addDirectorForm" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Đạo Diễn Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" name="Name" class="form-control" placeholder="Tên đạo diễn" required />
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-success">Lưu</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Add Actor -->
<div class="modal fade" id="addActorModal" tabindex="-1" aria-labelledby="addActorModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="addActorForm" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Diễn Viên Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" name="Name" class="form-control" placeholder="Tên diễn viên" required />
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-success">Lưu</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(function () {
            // Kích hoạt select2
            $('.select2').select2({
                width: '100%',
                placeholder: "Chọn mục",
                allowClear: true
            });

            $('#addDirectorForm').submit(function (e) {
                e.preventDefault();
                let name = $(this).find('[name="Name"]').val();
                $.post('@Url.Action("AddDirector", "Directors")', { name }, function (data) {
                    if (data.success) {
                        $('#addDirectorModal').modal('hide');
                        $('select[name="DIRECTORID"]').append(`<option value="${data.id}" selected>${data.name}</option>`);
                    }
                });
            });

            $('#addActorForm').submit(function (e) {
                e.preventDefault();
                let name = $(this).find('[name="Name"]').val();
                $.post('@Url.Action("AddActor", "Actors")', { name }, function (data) {
                    if (data.success) {
                        $('#addActorModal').modal('hide');
                        let $select = $('select[name="selectedActors"]');
                        $select.append(new Option(data.name, data.id, true, true)).trigger('change');
                    }
                });
            });
        });
    </script>
}
